.DS_Store
.env

# Portal dependencies
/portal/node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Test + tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.codex/

# Open WebUI per hub state
.openwebui-data/

# Signing and encryption keys. Open WebUI writes .webui_secret_key into the
# directory it starts in; the deployment key (HUBZOID_SECRET_KEY's file) is
# secret.key. Neither belongs in git.
.webui_secret_key
secret.key

# Per-hub chat/runtime state (uploads, per-chat artifacts)
.hubzoid/

# Shared Open WebUI state created in cwd by `hubzoid gateway`
.hubzoid-gateway/

# Per session hub outputs
**/output/

# Playwright MCP local cache (test artifacts; never tracked)
.playwright-mcp/

# Stray E2E screenshots Playwright drops in the repo root when called
# from a Claude session whose cwd is here. Intentional copies live in
# ../HubzoidTests/reports/ (a separate folder, outside this repo).
# The leading slash anchors the pattern to repo root only, so
# demo-hub/branding/*.png and hubzoid/templates/starter/branding/*.png
# are NOT excluded.
/demo-hub-*.png
/manual-*.png
/*-snap.yml
.venv/
