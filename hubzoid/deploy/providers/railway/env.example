# The variables to set on Railway (service > Variables). Put secrets there, never
# in a file in the image. Values here are examples.

# The address people open, once Railway has given the service a domain.
HUBZOID_PUBLIC_URL=https://your-hub.up.railway.app
# Sign-in on: required on a public address.
HUBZOID_AUTH=true
# The first owner, created at the first start. Remove the password after you sign in.
HUBZOID_ADMIN_EMAIL=you@example.com
HUBZOID_ADMIN_PASSWORD=
# The deployment key that encrypts stored connections and secrets. Generate it once:
#   python3 -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# and keep a copy outside Railway: a restore on a new volume needs it.
HUBZOID_SECRET_KEY=
# Railway mounts the volume as root; the Hubzoid image runs as a normal user.
RAILWAY_RUN_UID=0

# The model. With a Claude subscription: MODEL=claude-local and a token from
# `claude setup-token`. Or an API model and its key instead.
MODEL=claude-local
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Optional: PostgreSQL instead of SQLite on the volume (add Railway's PostgreSQL
# and reference it): DATABASE_URL=${{Postgres.DATABASE_URL}}
# Scheduled verified backups: weekly (default), daily or off.
HUBZOID_BACKUPS=weekly
