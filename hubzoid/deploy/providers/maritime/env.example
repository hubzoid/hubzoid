# The variables to set on Maritime (`maritime env set <agent> NAME=VALUE`,
# stored as secrets by default). Never put them in a file in the image. Values here are
# examples.

# The address people open: the agent's public URL from `maritime create --public`.
HUBZOID_PUBLIC_URL=https://your-hub.maritime.sh
# Sign-in on: required, because a public Maritime URL needs no login of its own.
HUBZOID_AUTH=true
# The first owner, created at the first start. Remove the password after you sign in.
HUBZOID_ADMIN_EMAIL=you@example.com
HUBZOID_ADMIN_PASSWORD=
# The deployment key that encrypts stored connections and secrets. Generate it once:
#   python3 -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# and keep a copy outside Maritime: a restore on a new machine needs it.
HUBZOID_SECRET_KEY=

# The model. With a Claude subscription: MODEL=claude-local and a token from
# `claude setup-token`. Or an API model and its key instead.
MODEL=claude-local
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Scheduled verified backups: weekly (default), daily or off. A sleeping machine
# backs up after it wakes; schedules need Always-on to run on time.
HUBZOID_BACKUPS=weekly
