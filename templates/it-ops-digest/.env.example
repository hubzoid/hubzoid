# it-ops-digest hub config. Copy this file to .env and edit.
# Without a .env the hub still runs: MODEL defaults to claude-local.

MODEL=claude-local

# Providers. MODEL=claude-local drives your installed `claude` CLI and bills
# through its Pro/Max subscription, no API key needed (run `claude login` once).
# For OpenAI, Anthropic, Azure OpenAI, or OpenRouter, set MODEL to a LiteLLM
# model id and add the matching key. See docs/providers.md in the Hubzoid repo.
# OPENROUTER_API_KEY=sk-or-v1-...
# MODEL=openrouter/anthropic/claude-haiku-4.5
# OPENAI_API_KEY=sk-...
# MODEL=openai/gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=anthropic/claude-haiku-4-5

PORT=3080
BRIDGE_PORT=8000
WEBUI_AUTH=False

# Surfaces (optional). Each one is off until its variables are set.
# Slack (hubzoid run my-hub --slack): SLACK_BOT_TOKEN, SLACK_APP_TOKEN. See docs/slack.md.
# Telegram (--telegram): TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET. See docs/inbound-surfaces.md.
# WhatsApp (--whatsapp): WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_VERIFY_TOKEN, WHATSAPP_APP_SECRET.
